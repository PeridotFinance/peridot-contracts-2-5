export LENDING_WAVAX_SEED_AMOUNT=12000000000000000000
export LENDING_USDC_SEED_AMOUNT=100000000
# borrow caps: USDC USD 5,000 (the pilot cap); WAVAX borrowing stays PAUSED (the cap only bounds a mistake: 120 WAVAX, about USD 1,000)
export LENDING_WAVAX_BORROW_CAP=120000000000000000000
export LENDING_USDC_BORROW_CAP=5000000000
export LENDING_RESERVE_FACTOR=100000000000000000
export LENDING_CLOSE_FACTOR=500000000000000000
