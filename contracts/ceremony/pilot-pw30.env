# Cash-only lending PW30: the 20 deployment inputs (PUBLIC values only; no key, no endpoint). PROPOSED values awaiting the operator's confirmation,
# see docs/deployment-handoffs/avalanche-pilot-deployment-ceremony.md section 1. Used by tools/avalanche-ceremony.sh (rehearsal and live).
export DEPLOYER=0x064eFE76812F5f18Bd1aA9708739Fb33C810B2dD
export PERIDOT_TOKEN=0x0000000000000000000000000000000000000000
export LENDING_ALLOW_NO_REWARD_TOKEN=true
export PAUSE_GUARDIAN=0x064eFE76812F5f18Bd1aA9708739Fb33C810B2dD
