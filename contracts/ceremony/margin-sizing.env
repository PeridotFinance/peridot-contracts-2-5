# Margin 2x sizing inputs (PUBLIC). GENERATED by tools/pilot-sizing.py at CAP = USD 200. The script derives the pair's position cap (= CAP) and debt cap (= CAP/2) from MARGIN_CAP_USD.
export MARGIN_CAP_USD=200
export MARGIN_FLASH_SEED_USDC=100000000
export MARGIN_INSURANCE_SEED_USDC=10000000
export MARGIN_ACTION_DELAY=86400
