# Margin 2x ceremony inputs on top of the live PW30 (PUBLIC values only; no key, no endpoint). Pilot CAP = USD 200. Used by tools/avalanche-margin-ceremony.sh.
# Sourced together with ceremony/margin-sizing.env (MARGIN_CAP_USD, MARGIN_FLASH_SEED_USDC, MARGIN_INSURANCE_SEED_USDC, MARGIN_ACTION_DELAY).
source "$(dirname "${BASH_SOURCE[0]:-$0}")/margin-sizing.env"
export MARGIN_OWNER=0x064eFE76812F5f18Bd1aA9708739Fb33C810B2dD
# the throwaway deployer (generated on pilot-keeper; holds no role at any time); the Foundry keystore NAME you import it under on your machine:
export MARGIN_DEPLOYER=0x7413c1C72BAAfFc640C00Ba759BF14826b12C8C7
export MARGIN_DEPLOYER_ACCOUNT=pilot-deployer
# live PW30 (deployed 9 Nov 2026, block 99,846,691)
export CONTROLLER=0xbE938cD7C25E0E4d0604Fa3F9f0a8B5B67b3D51A
export PWAVAX=0x12f1F4Fc057a76f473B781ce2Fa88E55ef8581B1
export PUSDC=0x0f7849CD9E54ffb027aacaEec82007cca9470098
# the two funded liquidators = the two operator wallets (pilot-op1, pilot-op2)
export MARGIN_FUNDERS=0xA7640fc537E2172eD6c4b4A809C9456AbD60fbF4,0xfbb137eBcBb0F7eb2Ba70F59ff0be9B0A0c5125d
