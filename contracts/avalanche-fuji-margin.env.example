# Public configuration only. Never place a private key or keystore password here.
# Copy the required values into the ignored contracts/.env before running scripts.

AVALANCHE_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
FOUNDRY_ACCOUNT=REPLACE_WITH_FOUNDRY_KEYSTORE_NAME
MARGIN_DEPLOYER=REPLACE_WITH_KEYSTORE_PUBLIC_ADDRESS
MARGIN_OWNER=REPLACE_WITH_SAME_KEYSTORE_PUBLIC_ADDRESS_FOR_INITIAL_FUJI_DEPLOYMENT
MARGIN_TREASURY=REPLACE_WITH_FUJI_TREASURY_ADDRESS
MARGIN_ACTION_DELAY=86400

# Fresh Fuji-only lending base. DeployAvalancheFujiLendingMarkets creates the testnet PERIDOT,
# price oracle, Unitroller/Peridottroller, rate model, and atomically seeded pWAVAX/pUSDC markets.
# It requires MARGIN_OWNER == MARGIN_DEPLOYER so every temporary admin role is fully recovered.
FUJI_WAVAX=0xd00ae08403B9bbb9124bB305C09058E32C39A48c
FUJI_LFJ_USDC=0xB6076C93701D6a07266c31066B298AeC6dd65c2d
FUJI_AVAX_USD_FEED=0x5498BB86BC934c8D34FDA08E81D444153d0D06aD
FUJI_USDC_USD_FEED=0x97FE42a7E96640D932bbc0e1580c73E705A8EB73
FUJI_AVAX_FEED_MAX_AGE=1200
FUJI_USDC_FEED_MAX_AGE=90000
LENDING_PAUSE_GUARDIAN=REPLACE_WITH_FUJI_PAUSE_GUARDIAN
# Small Fuji-only canary values: 0.1 WAVAX / 2 LFJ USDC seed and 0.5 WAVAX / 10 USDC caps.
LENDING_WAVAX_SEED_AMOUNT=100000000000000000
LENDING_USDC_SEED_AMOUNT=2000000
LENDING_WAVAX_BORROW_CAP=500000000000000000
LENDING_USDC_BORROW_CAP=10000000
LENDING_BLOCKS_PER_YEAR=31536000
LENDING_BASE_RATE_PER_YEAR=20000000000000000
LENDING_MULTIPLIER_PER_YEAR=100000000000000000
LENDING_JUMP_MULTIPLIER_PER_YEAR=1000000000000000000
LENDING_KINK=800000000000000000
LENDING_RESERVE_FACTOR=100000000000000000
LENDING_CLOSE_FACTOR=500000000000000000
LENDING_LIQUIDATION_INCENTIVE=1080000000000000000

# Optional one-time preparation for an AVAX-funded Fuji deployer. Wrap 0.5 AVAX and swap
# 0.3 WAVAX to LFJ USDC, with a Chainlink-derived minimum output and at most 5% slippage.
# The script refuses to leave less than 0.75 native AVAX available for deployment gas.
PREPARE_WRAP_AVAX_AMOUNT=500000000000000000
PREPARE_SWAP_WAVAX_AMOUNT=300000000000000000
PREPARE_MAX_SLIPPAGE_BPS=500
PREPARE_MIN_NATIVE_GAS_BALANCE=750000000000000000

# Copy these three addresses from the lending deployment output before deploying margin.
PERIDOTTROLLER=REPLACE_AFTER_LENDING_DEPLOYMENT
PWAVAX=REPLACE_AFTER_LENDING_DEPLOYMENT
PUSDC=REPLACE_AFTER_LENDING_DEPLOYMENT
MARGIN_PTOKENS=REPLACE_WITH_PWAVAX,REPLACE_WITH_PUSDC
MARGIN_ASSETS=0xd00ae08403B9bbb9124bB305C09058E32C39A48c,0xB6076C93701D6a07266c31066B298AeC6dd65c2d
# Official Chainlink Fuji AVAX/USD (600-second heartbeat) and USDC/USD (86400-second heartbeat),
# verified directly on Fuji. Testnet max ages include a small execution buffer.
MARGIN_CHAINLINK_FEEDS=0x5498BB86BC934c8D34FDA08E81D444153d0D06aD,0x97FE42a7E96640D932bbc0e1580c73E705A8EB73
MARGIN_FEED_MAX_AGES=1200,90000
WIRE_CONTROLLER=false

# Run ActivateAvalancheFujiMarginMarkets only after the margin risk hook and registrar are wired.
# The activation script requires margin opens to still be paused and leaves spot collateral at zero.
ACTIVATE_FUJI_MARGIN_BORROWS=false

# Official LFJ Fuji V2.2 router. The documented live AVAX/USDC test pair is V2.1, bin step 20.
LFJ_LB_ROUTER=0x18556DA13313f3532c54711497A8FedAC273220E
LFJ_WAVAX=0xd00ae08403B9bbb9124bB305C09058E32C39A48c
LFJ_USDC=0xB6076C93701D6a07266c31066B298AeC6dd65c2d
LFJ_MARGIN_ADAPTER=REPLACE_AFTER_ADAPTER_DEPLOYMENT
ISOLATED_MARGIN_SWAP_MODULE=REPLACE_AFTER_MARGIN_DEPLOYMENT
LFJ_TOKEN_A=0xd00ae08403B9bbb9124bB305C09058E32C39A48c
LFJ_TOKEN_B=0xB6076C93701D6a07266c31066B298AeC6dd65c2d
LFJ_BIN_STEP=20
LFJ_VERSION=2
LFJ_ROUTE_ALLOWED=true

# Deploy a Fuji-only SimpleFlashLoanVault first. It starts paused, charges no flash fee by default,
# and must be funded/verified in a separate run. Configure every possible debt underlying.
FLASH_VAULT_FEE_BPS=0
FLASH_VAULT_TOKEN_COUNT=2
FLASH_VAULT_TOKEN_0=0xB6076C93701D6a07266c31066B298AeC6dd65c2d
FLASH_VAULT_TOKEN_1=0xd00ae08403B9bbb9124bB305C09058E32C39A48c
FLASH_VAULT_SEED_AMOUNT_0=REPLACE_WITH_LFJ_USDC_BASE_UNITS
FLASH_VAULT_SEED_AMOUNT_1=REPLACE_WITH_WAVAX_BASE_UNITS
FLASH_VAULT_MIN_LIQUIDITY_0=REPLACE_WITH_MIN_LFJ_USDC_BASE_UNITS
FLASH_VAULT_MIN_LIQUIDITY_1=REPLACE_WITH_MIN_WAVAX_BASE_UNITS
UNPAUSE_FLASH_VAULT=false

# Margin deployment uses this lender only after its funding checks pass and it is explicitly unpaused.
MARGIN_ROUTER_ADAPTER=REPLACE_AFTER_ADAPTER_DEPLOYMENT
MARGIN_FLASH_LENDER=REPLACE_AFTER_FLASH_VAULT_DEPLOYMENT

# Pair configuration. Run once with EXECUTE=false, wait MARGIN_ACTION_DELAY, then set EXECUTE=true.
ISOLATED_MARGIN_CONFIG=REPLACE_AFTER_MARGIN_DEPLOYMENT
ISOLATED_MARGIN_RISK_ENGINE=REPLACE_AFTER_MARGIN_DEPLOYMENT
MARGIN_PTOKEN=REPLACE_WITH_COLLATERAL_PTOKEN
POSITION_PTOKEN=REPLACE_WITH_POSITION_PTOKEN
DEBT_PTOKEN=REPLACE_WITH_DEBT_PTOKEN
EXECUTE=false
UNPAUSE_OPENS=false

# Conservative Fuji defaults are repeated explicitly for review.
MAX_LEVERAGE_X100=200
INITIAL_MARGIN_BPS=5000
MAINTENANCE_MARGIN_BPS=3500
LIQUIDATION_TARGET_BPS=12500
FULL_LIQUIDATION_HEALTH_BPS=5000
MAX_LIQUIDATION_BPS=5000
LIQUIDATION_BONUS_BPS=500
MAX_SLIPPAGE_BPS=100
ORACLE_DEVIATION_BPS=100
MAX_POSITION_VALUE_USD=10000000000000000000000
MAX_DEBT_VALUE_USD=5000000000000000000000

# Keep every activation gate false until its named test has actually passed on the live Fuji stack.
CONFIRM_ALL_FUJI_PAIRS_CONFIGURED=false
CONFIRM_FUJI_ROUTE_TESTED=false
CONFIRM_FUJI_ORACLES=false
CONFIRM_FUJI_LIFECYCLE_TESTS=false
CONFIRM_FUJI_LIQUIDATION_TESTED=false
MIN_INSURANCE_PTOKEN_BALANCE=REPLACE_AFTER_READING_PTOKEN_DECIMALS_AND_EXCHANGE_RATE
MIN_FLASH_LIQUIDITY_UNDERLYING=REPLACE_AFTER_READING_DEBT_TOKEN_DECIMALS
