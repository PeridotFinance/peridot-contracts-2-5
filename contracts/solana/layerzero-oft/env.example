#
# Peridot: Solana Devnet OFT (LayerZero V2) environment
#
# Copy to .env:
#   cp env.example .env
#

# Solana "testnet" in LayerZero docs refers to Solana Devnet.
RPC_URL_SOLANA_TESTNET=https://api.devnet.solana.com
RPC_URL_SOLANA=https://api.devnet.solana.com

# If Solana Hardhat tasks fail with `TypeError: fetch failed` / `UND_ERR_CONNECT_TIMEOUT`,
# it is usually Node trying IPv6 first in some environments.
# Fix by forcing IPv4 DNS ordering for Node-based tasks:
#
#   export NODE_OPTIONS=--dns-result-order=ipv4first

# Use your keypair JSON file (64-number array). You already created:
SOLANA_KEYPAIR_PATH=/home/josh/peridot-ccip/contracts/solana/id.json

# Optional alternative to SOLANA_KEYPAIR_PATH:
# SOLANA_PRIVATE_KEY=<base58 or "[1,2,3,...]" one-line array>

# Your existing SPL mint on devnet (from token:create output)
SOLANA_MINT_ADDRESS=

# EVM deployer for wiring on EVM (only needed if you use the Hardhat wiring tasks)
PRIVATE_KEY=

# Optional EVM RPCs (if you later wire to these chains from this workspace)
RPC_URL_BSC_TESTNET=https://bsc-testnet-rpc.publicnode.com
RPC_URL_BASE_SEPOLIA=

