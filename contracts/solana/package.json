{
  "name": "peridot-solana",
  "private": true,
  "version": "0.1.0",
  "description": "Peridot Solana tooling (SPL token + Metaplex metadata + LayerZero OFT integration scaffolding).",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "token:create": "node --loader ts-node/esm src/token/create_mint.ts",
    "token:mint": "node --loader ts-node/esm src/token/mint_to.ts",
    "token:metadata": "node --loader ts-node/esm src/token/set_metadata.ts"
  },
  "dependencies": {
    "@metaplex-foundation/js": "^0.20.1",
    "@metaplex-foundation/mpl-token-metadata": "^3.4.0",
    "@metaplex-foundation/umi-bundle-defaults": "^1.0.0",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.0",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
