# SEPARATE MOCK-ONLY FUJI FIXTURE. No real USDC, redeemable WAVAX, Chainlink or LFJ.
# Do not replace the existing real-token .env with this file or copy mock addresses into it.
# Supply these as process-local environment variables for the mock scripts.
MOCK_MARGIN_DEPLOYER=REPLACE_WITH_KEYSTORE_PUBLIC_ADDRESS
CONFIRM_FUJI_MOCK_ONLY=false

# Fill only from VERIFIED DeployFujiMockMargin broadcast output.
MOCK_RISK_ENGINE=REPLACE_AFTER_MOCK_DEPLOYMENT
MOCK_PAVAX=REPLACE_AFTER_MOCK_DEPLOYMENT
MOCK_PUSD=REPLACE_AFTER_MOCK_DEPLOYMENT

# Configuration is queued first, then executed after the actual 86400-second delay.
# Trading activation is a distinct reviewed action. Defaults keep all trading paused.
MOCK_EXECUTE=false
MOCK_ENABLE_TRADING=false
